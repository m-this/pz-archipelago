# Every pinned version the build reads, one line each. The Makefile includes
# this file; CI runs the Makefile, so a bump here is a bump everywhere.

# The Archipelago release the apworld is tested against.
ARCHIPELAGO_VERSION=0.6.8
# Archipelago 0.6.8 runs on 3.11 to 3.13.
PYTHON_VERSION=3.13

GOFUMPT_VERSION=v0.12.0
GOLANGCI_LINT_VERSION=v2.14.0
